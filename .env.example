# =============================================================================
# Portfolio v2 — Environment Variables
# =============================================================================
# Copy this file to .env.local and customize values for local development.
# .env.local is gitignored and will NOT be committed.
#
# All NEXT_PUBLIC_ variables are inlined at build time (static export).
# Changes require a rebuild (pnpm build) to take effect.
# =============================================================================

# ── Background Animation ─────────────────────────────────────────────────────
#
# NEXT_PUBLIC_BG_MODE controls which background animation is shown.
#
#   "switcher"  → Show the on-screen switcher button (default).
#                 User can pick any of the 20 animations.
#                 NEXT_PUBLIC_DEFAULT_BG sets the initial selection.
#
#   "random"    → Pick a random animation on every page load.
#                 No switcher button is shown.
#
#   "<id>"      → Lock to a specific animation. No switcher shown.
#                 Valid IDs: aurora, particles, dotgrid, glass, waves,
#                 starfield, matrix, neural, fireflies, topography, rain,
#                 bokeh, vortex, ripple, neonrings, matrixrain, hexgrid,
#                 gradient, constellation, spotlight
#
# Examples:
#   NEXT_PUBLIC_BG_MODE=switcher
#   NEXT_PUBLIC_BG_MODE=random
#   NEXT_PUBLIC_BG_MODE=neural
#
NEXT_PUBLIC_BG_MODE=random

# Default background when mode is "switcher".
# Also used as the locked background when NEXT_PUBLIC_BG_SWITCHER=false (legacy).
NEXT_PUBLIC_DEFAULT_BG=neural

# ── Legacy ────────────────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_BG_SWITCHER is the older way to control the switcher.
# Set to "false" to hide the switcher and lock to NEXT_PUBLIC_DEFAULT_BG.
# Ignored when NEXT_PUBLIC_BG_MODE is explicitly set.
#
# NEXT_PUBLIC_BG_SWITCHER=false

# ── Telemetry / Logging ───────────────────────────────────────────────────────
#
# Set to "true" to enable component telemetry logging by default.
# When "true", every component logs mount/unmount/render events to the console.
# Can be toggled at runtime via: window.__PORTFOLIO_TELEMETRY__.toggle()
# Default: false (telemetry off)
#
NEXT_PUBLIC_ENABLE_LOGS=false

# ── Contact Form ─────────────────────────────────────────────────────────────
#
# Public values only; both are inlined at build time. The contact form POSTs to
# the Cloudflare Worker and falls back to mailto: when either value is unset.
# Never put BREVO_API_KEY or TURNSTILE_SECRET_KEY here: those live only on the
# Worker (workers/contact).
#
# Worker endpoint. A bare host is also accepted; the Worker answers POST on any
# path. Local example: http://localhost:8787
NEXT_PUBLIC_CONTACT_ENDPOINT=https://your-worker.your-subdomain.workers.dev

# Cloudflare Turnstile site key (the matching secret key is a Worker secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key